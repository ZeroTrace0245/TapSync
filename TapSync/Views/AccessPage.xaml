<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TapSync.Views.AccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="16" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Access Activity" Style="{ThemeResource HeaderTextBlockStyle}" />
            <TextBlock Text="Recent gate access logs and entry decisions" Style="{ThemeResource BodyTextBlockStyle}" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="AccessLogsList" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="16" Padding="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding AttendeeFullName}" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{Binding Gate}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />

                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Reason}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding AccessTimeFormatted}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
