<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TapSync.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageHeaderTextStyle}" />
            <TextBlock Text="Personalise how TapSync looks." Style="{StaticResource PageSubtitleTextStyle}" />

            <InfoBar x:Name="ErrorInfoBar" Severity="Error" IsOpen="False" Margin="0,0,0,8" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextStyle}" />

            <!-- App theme -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Choose light, dark, or follow Windows" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeComboBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Background mode -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE771;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Background" />
                        <TextBlock Text="Mica follows your wallpaper, Acrylic blurs the desktop, or use your own picture"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="BackgroundModeComboBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="BackgroundModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="Picture" Tag="Image" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Picture options: shown only in Picture mode -->
            <StackPanel x:Name="PictureOptionsPanel" Spacing="4" Visibility="Collapsed">

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="160" Height="90" CornerRadius="6"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <FontIcon x:Name="PreviewPlaceholderIcon" Glyph="&#xEB9F;" FontSize="28"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Background picture" />
                            <TextBlock x:Name="ImageNameText" Text="No picture selected"
                                       Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BrowseButton" Style="{StaticResource AccentButtonStyle}" Click="BrowseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Browse photos" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveImageButton" Content="Remove" Click="RemoveImageButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE727;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Blur effect" />
                            <TextBlock Text="Frosted-glass blur over your picture, like Windows 11"
                                       Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="BlurToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                      OnContent="On" OffContent="Off" Toggled="BlurToggle_Toggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tint strength" />
                            <TextBlock Text="Higher values soften the picture so text is easier to read"
                                       Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="TintSlider" Width="200" Minimum="0" Maximum="90" StepFrequency="5"
                                    VerticalAlignment="Center" ValueChanged="TintSlider_ValueChanged" />
                            <TextBlock x:Name="TintValueText" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderTextStyle}" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///AppIcon.ico" Width="24" Height="24" Margin="2,0,6,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TapSync" />
                        <TextBlock Text="NFC event access control" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
