<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TapSync.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TapSync.Views"
    Background="Transparent">

    <Page.Resources>
        <!-- One statistic tile -->
        <DataTemplate x:Key="StatTileTemplate" x:DataType="local:StatTile">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind Value}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock x:Name="GreetingText" Text="Dashboard" Style="{StaticResource PageHeaderTextStyle}" />
            <TextBlock x:Name="EventSubtitleText" Style="{StaticResource PageSubtitleTextStyle}" />

            <!-- Stat tiles, wrapping on narrow windows -->
            <ItemsRepeater x:Name="StatsRepeater" ItemTemplate="{StaticResource StatTileTemplate}" Margin="0,0,-12,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="230" MinItemHeight="128" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <Grid ColumnSpacing="12" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Check-in by category -->
                <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel>
                            <TextBlock Text="Check-in by category" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Share of each group already through the gates"
                                       Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryProgress">
                                    <Grid Margin="0,0,0,14" RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Summary}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{x:Bind Percent}" Maximum="100"
                                                     Foreground="{x:Bind Brush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent activity -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Recent gate activity" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Latest NFC taps at the entrances" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="NoActivityText" Text="No one has tapped in yet."
                                   Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="Collapsed" />
                        <ItemsControl x:Name="ActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityItem">
                                    <Grid Margin="0,0,0,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture Width="36" Height="36" Initials="{x:Bind Initials}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Gate}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Time}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionSecondaryTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
