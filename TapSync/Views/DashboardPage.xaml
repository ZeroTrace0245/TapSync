<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TapSync.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24">
        <TextBlock Text="TapSync Dashboard" Style="{ThemeResource HeaderTextBlockStyle}"/>
        <TextBlock x:Name="CheckInProgressText" Text="Check-In: 0/0" Margin="0,16,0,0"/>
        <ProgressBar x:Name="VIPCapacityBar" Value="50" Maximum="100" Margin="0,8,0,0"/>
        <TextBlock x:Name="VIPCapacityText" Text="VIP: 50%"/>
        <ProgressBar x:Name="GeneralCapacityBar" Value="70" Maximum="100" Margin="0,8,0,0"/>
        <TextBlock x:Name="GeneralCapacityText" Text="General: 70%"/>
        <ProgressBar x:Name="StaffCapacityBar" Value="30" Maximum="100" Margin="0,8,0,0"/>
        <TextBlock x:Name="StaffCapacityText" Text="Staff: 30%"/>
    </StackPanel>
</Page>