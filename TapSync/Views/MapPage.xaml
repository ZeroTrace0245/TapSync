<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TapSync.Views.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TapSync.Models"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="12">
            <StackPanel>
                <TextBlock Text="Live Heatmap" Style="{StaticResource PageHeaderTextStyle}" />
                <TextBlock Text="Real-time attendee locations across the venue." Style="{StaticResource PageSubtitleTextStyle}" Margin="0" />
            </StackPanel>

            <!-- Toolbar -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartSimulationButton" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Start Tracking" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopSimulationButton" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="Stop Tracking" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearAll">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" FontSize="14" />
                                <TextBlock Text="Clear All" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="CategoryFilterComboBox" PlaceholderText="Filter by category" MinWidth="150">
                            <x:String>All</x:String>
                            <x:String>General</x:String>
                            <x:String>VIP</x:String>
                            <x:String>Staff</x:String>
                            <x:String>Press</x:String>
                        </ComboBox>
                        <ToggleButton x:Name="HeatmapToggleButton" Content="Heatmap" IsChecked="True" />
                        <ToggleButton x:Name="ZonesToggleButton" Content="Zones" IsChecked="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Map -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Canvas x:Name="MapCanvas" Height="420" Background="Transparent" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="12,6"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Tracking" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TotalTrackedText" Text="0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Zones" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl x:Name="ZoneStatsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MapZone">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionSecondaryTextStyle}">
                                            <Run Text="{x:Bind RadiusMeters}" /><Run Text=" m radius" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Latest movements" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl x:Name="AttendeeListItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LocationData">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{x:Bind AttendeeName}" />
                                        <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}">
                                            <Run Text="{x:Bind Zone}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Category}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
