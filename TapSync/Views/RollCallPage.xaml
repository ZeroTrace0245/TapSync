<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TapSync.Views.RollCallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock Text="Emergency Roll Call" Style="{StaticResource PageHeaderTextStyle}" />
            <TextBlock Text="See who is still inside the venue during an evacuation." Style="{StaticResource PageSubtitleTextStyle}" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="32">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="26"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="Coming soon" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="This section is being built. Its features will appear here."
                               HorizontalAlignment="Center" Style="{StaticResource CaptionSecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
